{
  "name": "dsh-plugin-workbuddy",
  "version": "0.1.1",
  "description": "WorkBuddy model provider for DeepSeek Harness: registers the WorkBuddy model catalog with each model's credit multiplier (倍率)",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-plugin-workbuddy": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "3.18.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@standard-schema/spec": "1.0.0"
  }
}
